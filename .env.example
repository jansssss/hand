# Vercel 프로젝트 환경 변수
# 로컬에서는 `vercel env pull` 로 .env 를 받아 쓰세요.

OPENAI_API_KEY=sk-...

# 선택 · 기본값 gpt-4o (비전 지원 모델이어야 합니다)
# OPENAI_MODEL=gpt-4o

# 선택 · 100만 토큰당 USD 단가. 표에 없는 모델은 비용을 계산하지 않습니다.
# OPENAI_PRICES={"gpt-5-mini":{"input":0.25,"cachedInput":0.025,"output":2}}

# 선택 · 원화 환산 환율 (기본 1400)
# USD_KRW=1400
